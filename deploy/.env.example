# DCF Feedback Analytics — production (path-based hosting)
# Copy to deploy/.env. deploy/.env is gitignored.

NODE_ENV=production
HOST=127.0.0.1
HOST_PORT=14020
PORT=14020
APP_BASE_PATH=/feedback
TRUST_PROXY=1

# Public hostname — TLS terminates at nginx
PUBLIC_HOST=client-demo.inapp.com
PUBLIC_SCHEME=https
PUBLIC_ORIGIN=https://client-demo.inapp.com
PUBLIC_SURVEY_BASE_URL=/feedback/survey
CORS_ORIGIN=*

# Shared inapp TLS cert (existing client-demo.inapp.com vhost)
SSL_CERTIFICATE=/etc/ssl/inapp/SSL/inapp.com.pem
SSL_CERTIFICATE_KEY=/etc/ssl/inapp/SSL/inapp.com.key
NGINX_STRATEGY=snippet
NGINX_SNIPPET=/etc/nginx/snippets/dcf-feedback.conf

# SQLite (bare metal). Docker images used sqlite://./data/feedback.db inside the container.
DATABASE_URL=sqlite://./data/feedback.db

# Demo scheduler windows
DEMO_FAST_TRIGGERS=true

# Frontend (baked at build time — keep in sync with APP_BASE_PATH)
VITE_BASE_PATH=/feedback/
VITE_API_BASE_URL=/feedback/v1

# Hugging Face — optional. Empty ⇒ heuristic fallback. Do not commit a live token.
LLM_PROVIDER=huggingface
HF_MODEL=Qwen/Qwen2.5-7B-Instruct:featherless-ai
HF_API_BASE=https://router.huggingface.co/v1
HF_API_TOKEN=
HUGGINGFACE_API_KEY=
LLM_REQUEST_TIMEOUT_MS=600000
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_MS=1200
