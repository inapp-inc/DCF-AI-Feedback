# =============================================================================
# DCF AI Feedback — template (no secrets)
# For packaging: copy to docker/.env and set HF_API_TOKEN, then run package-docker.sh
# The packager bundles docker/.env as .env inside the zip for deploy-docker.sh.
# =============================================================================

# ---- Routing (must match host nginx path prefix) ----
APP_BASE_PATH=/dcffeedback
APP_HTTP_PORT=4020

# ---- Backend (Express listens on 8080 inside the container; not published to host) ----
PORT=8080
NODE_ENV=production
DATABASE_URL=sqlite://./data/feedback.db

# Reflect request origin (recommended). Or comma-separated origins.
CORS_ORIGIN=*

# Survey links returned by API (relative path; works with host nginx + :4020)
PUBLIC_SURVEY_BASE_URL=/dcffeedback/survey

# Optional: make survey links absolute (e.g. https://your-host.example.com)
# PUBLIC_ORIGIN=

# Demo trigger scheduler: fast windows unless set to false
DEMO_FAST_TRIGGERS=true

# ---- Frontend build (docker compose build args — keep in sync with APP_BASE_PATH) ----
VITE_BASE_PATH=/dcffeedback/
VITE_API_BASE_URL=/dcffeedback/v1

# ---- Hugging Face inference ----
# Required for live LLM (classification, acknowledgements, reports). Get a token at:
# https://huggingface.co/settings/tokens
LLM_PROVIDER=huggingface
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_API_BASE=https://router.huggingface.co/v1
HF_API_TOKEN=
# Alias (either HF_API_TOKEN or HUGGINGFACE_API_KEY is read by the app)
HUGGINGFACE_API_KEY=

# Timeouts / retries
LLM_REQUEST_TIMEOUT_MS=600000
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_MS=1200
