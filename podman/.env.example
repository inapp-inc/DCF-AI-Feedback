# =============================================================================
# Feedback Analytics — local Podman template (no secrets)
# Copy to podman/.env and set HF_API_TOKEN for live LLM features.
# Scripts will also reuse docker/.env if that file already exists.
# =============================================================================

# ---- Routing (browser URL prefix) ----
APP_BASE_PATH=/feedback
APP_HTTP_PORT=4020

# ---- Backend (Express listens on 8080 inside the container; not published) ----
PORT=8080
NODE_ENV=production
DATABASE_URL=sqlite://./data/feedback.db

# Reflect request origin (recommended). Or comma-separated origins.
CORS_ORIGIN=*

# Survey links returned by API (relative path)
PUBLIC_SURVEY_BASE_URL=/feedback/survey

# Optional: make survey links absolute (e.g. http://127.0.0.1:4020)
# PUBLIC_ORIGIN=http://127.0.0.1:4020

# Demo trigger scheduler: fast windows unless set to false
DEMO_FAST_TRIGGERS=true

# ---- Frontend build args (keep in sync with APP_BASE_PATH; rebuild after change) ----
VITE_BASE_PATH=/feedback/
VITE_API_BASE_URL=/feedback/v1

# ---- Hugging Face inference ----
# Required for live LLM (classification, acknowledgements, reports).
# https://huggingface.co/settings/tokens
LLM_PROVIDER=huggingface
HF_MODEL=Qwen/Qwen2.5-7B-Instruct:featherless-ai
HF_API_BASE=https://router.huggingface.co/v1
HF_API_TOKEN=
HUGGINGFACE_API_KEY=

# Timeouts / retries
LLM_REQUEST_TIMEOUT_MS=600000
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_MS=1200
